  <actuator>
    <general class="size3" name="shoulder_pan" joint="shoulder_pan_joint"/>
    <general class="size3" name="shoulder_lift" joint="shoulder_lift_joint"/>
    <general class="size3_limited" name="elbow" joint="elbow_joint"/>
    <general class="size1" name="wrist_1" joint="wrist_1_joint"/>
    <general class="size1" name="wrist_2" joint="wrist_2_joint"/>
    <general class="size1" name="wrist_3" joint="wrist_3_joint"/>
    <!-- Gripper actuator -->
    <position name="fingers_actuator" joint="right_driver_joint" kp="100" ctrlrange="0 0.8"/>
  </actuator>
  
  <equality>
    <!-- Gripper finger synchronization -->
    <joint joint1="right_driver_joint" joint2="left_driver_joint" polycoef="0 1 0 0 0"/>
    <connect anchor="0 0 0" body1="right_follower" body2="right_coupler"/>
    <connect anchor="0 0 0" body1="left_follower" body2="left_coupler"/>
  </equality>
  
  <contact>
    <exclude body1="gripper_body" body2="left_driver"/>
    <exclude body1="gripper_body" body2="right_driver"/>
    <exclude body1="gripper_body" body2="left_spring_link"/>
    <exclude body1="gripper_body" body2="right_spring_link"/>
    <exclude body1="right_coupler" body2="right_follower"/>
    <exclude body1="left_coupler" body2="left_follower"/>
  </contact>

