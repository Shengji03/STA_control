             dir=(0.95, -0.1, -1.35) 瞄准阀门 -->
        <light name="glare_light" pos="-0.5 0.5 2.0" dir="0.95 -0.1 -1.35"
               directional="false" castshadow="true"
               cutoff="30" exponent="2"
               diffuse="3.5 3.2 2.5" specular="0.8 0.7 0.5"
               attenuation="1.0 0.0 0.0"/>
