        <light pos="1 0 4" dir="0 0 -1" directional="true"
               diffuse="0.20 0.20 0.20" specular="0.05 0.05 0.05"/>
        <!-- 强烈斜射阳光: 从 R臂侧上方 (x=-0.5, z=2.0) 斜射到阀门
             光线从上方斜射穿过遮光板位置 (x=0.20, z=0.8) 到达阀门 (x=0.45, z=0.65)
